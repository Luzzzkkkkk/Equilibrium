@model Medico
@{
    ViewData["Title"] = "Área do profissional";
}
<section class="auth-page">
    <div class="auth-card auth-card-wide">
        <a class="auth-brand" asp-controller="Medico" asp-action="Index">Equilibrium</a>
        <p class="auth-eyebrow">ÁREA DO PROFISSIONAL</p>
        <h1>Olá, @Model.Nome.</h1>
        <p class="auth-intro">@Model.Especialidade · CRM @Model.CRM</p>
        <article class="card">
            <h2>Consultas agendadas</h2>
            <p>Veja os horários e os dados dos pacientes vinculados às suas consultas.</p>
            <a class="auth-button" asp-action="Consultas">Abrir minha agenda</a>
        </article>
    </div>
</section>
