@model Consulta
@{
    ViewData["Title"] = "Consulta agendada";
}
<section class="auth-page">
    <div class="auth-card">
        <a class="auth-brand" asp-controller="Home" asp-action="MeuEspaco">Equilibrium</a>
        <p class="auth-eyebrow">AGENDAMENTO CONCLUÍDO</p>
        <h1>Consulta solicitada.</h1>
        <p class="auth-intro">Confira os dados do seu agendamento.</p>
        <article class="card">
            <h2>@Model.Medico.Nome</h2>
            <p>@Model.Medico.Especialidade</p>
            <p><strong>Data e horário:</strong> @Model.DataHora.ToString("dddd, dd/MM/yyyy 'às' HH:mm", new System.Globalization.CultureInfo("pt-BR"))</p>
            <p><strong>Status:</strong> @Model.Status</p>
        </article>
        @if (Model.Status != "Realizada" && Model.Status != "Cancelada")
        {
            <form asp-controller="Paciente" asp-action="Cancelar" method="post" class="mt-3" onsubmit="return confirm('Deseja cancelar esta consulta?');">
                <input type="hidden" name="id" value="@Model.Id" />
                <button type="submit" class="btn btn-outline-danger">Cancelar consulta</button>
            </form>
        }
        <p class="auth-switch"><a asp-controller="Home" asp-action="Consultas">Ver todas as consultas</a></p>
    </div>
</section>
