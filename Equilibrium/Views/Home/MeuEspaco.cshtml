@model Paciente
@{
    ViewData["Title"] = "Meu espaço";
    ViewData["PaginaAtiva"] = "MeuEspaco";
}

<div class="dashboard">
    <partial name="_Sidebar" />

    <main class="conteudo">
        <header class="topo">
            <div>
                <p>SEU ESPAÇO DE ACOLHIMENTO</p>
                <h2>Meu espaço</h2>
            </div>

            <div class="perfil">
                <span>✧</span>
                <span>@Model.Nome</span>
            </div>
        </header>

        <section class="secao">
            <p class="subtitulo">SEU CUIDADO PESSOAL</p>
            <h1>Seu espaço pessoal.</h1>
            <p>Olá, @Model.Nome. Acesse seus recursos de cuidado e encontre apoio profissional.</p>

            <article class="card">
                <h3>Seus dados</h3>
                <p><strong>E-mail:</strong> @Model.Email</p>
                <p><strong>CPF:</strong> @DadosPessoais.MascararCpf(Model.CPF)</p>
                <p><strong>Idade:</strong> @Model.Idade anos</p>
                <p><strong>Telefone:</strong> @DadosPessoais.MascararTelefone(Model.Telefone)</p>
                <p><strong>Endereço:</strong> @(string.IsNullOrWhiteSpace(Model.Endereco) ? "Não informado" : Model.Endereco)</p>
                <a asp-controller="Home" asp-action="Configuracoes">Acessar configurações →</a>
            </article>

            <div class="cards">
                <article class="card">
                    <h3>Meu bem-estar</h3>
                    <p>Acompanhe seu momento emocional com calma e atenção.</p>
                    <a asp-controller="Home" asp-action="BemEstar">Acessar →</a>
                </article>

                <article class="card">
                    <h3>Minhas consultas</h3>
                    <p>Consulte seus agendamentos e acompanhe seus atendimentos.</p>
                    <a asp-controller="Home" asp-action="Consultas">Acessar →</a>
                </article>

                <article class="card">
                    <h3>Profissionais</h3>
                    <p>Encontre profissionais e conheça as opções de apoio disponíveis.</p>
                    <a asp-controller="Home" asp-action="Profissionais">Encontrar →</a>
                </article>
            </div>
        </section>
    </main>
</div>
