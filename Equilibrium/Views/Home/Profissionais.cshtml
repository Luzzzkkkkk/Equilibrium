@{
    ViewData["Title"] = "Profissionais";
    ViewData["PaginaAtiva"] = "Profissionais";
}
@model IEnumerable<Medico>

<div class="dashboard">
    <partial name="_Sidebar" />

    <main class="conteudo">
        <header class="topo">
            <div>
                <p>SEU ESPAÇO DE ACOLHIMENTO</p>
                <h2>Profissionais</h2>
            </div>
            <div class="perfil"><span>✧</span><span>Paciente</span></div>
        </header>

        <section class="secao">
            <p class="subtitulo">CUIDADO E ACOLHIMENTO</p>
            <h1>Encontre apoio profissional.</h1>
            <p>Conheça profissionais e encontre opções de atendimento adequadas às suas necessidades.</p>

            <article class="card">
                <h3>Buscar profissionais</h3>
                <form method="get" asp-controller="Home" asp-action="Profissionais">
                    <label for="regiao">Região</label>
                    <input type="text" id="regiao" name="regiao" placeholder="Digite sua região" />

                    <label for="especialidade">Especialidade</label>
                    <select id="especialidade" name="especialidade">
                        <option value="">Todas</option>
                        <option value="Psicologia" selected="@(ViewBag.Especialidade as string == "Psicologia")">Psicologia</option>
                        <option value="Psiquiatria" selected="@(ViewBag.Especialidade as string == "Psiquiatria")">Psiquiatria</option>
                    </select>

                    <label for="genero">Gênero</label>
                    <select id="genero" name="genero">
                        <option value="">Todos</option>
                        <option value="Feminino">Feminino</option>
                        <option value="Masculino">Masculino</option>
                    </select>

                    <label for="disponibilidade">Disponibilidade</label>
                    <select id="disponibilidade" name="disponibilidade">
                        <option value="">Todas</option>
                        <option value="Online">Online</option>
                        <option value="Presencial">Presencial</option>
                    </select>

                    <button class="botao" type="submit">Buscar</button>
                </form>
            </article>

            <div class="cards">
                @if (!Model.Any())
                {
                    <article class="card"><h3>Nenhum profissional encontrado</h3><p>Cadastre médicos na tabela medicos para exibi-los aqui.</p></article>
                }
                @foreach (var medico in Model)
                {
                    <article class="card">
                        <h3>@medico.Nome</h3>
                        <p>@medico.Especialidade</p>
                        <p>CRM: @medico.CRM</p>
                    </article>
                }
            </div>
        </section>
    </main>
</div>
