@{
    ViewData["Title"] = "Profissionais";
    ViewData["PaginaAtiva"] = "Profissionais";
}
@model IEnumerable<Medico>

<div class="dashboard">
    <partial name="_Sidebar" />

    <main class="conteudo">
        <header class="topo">
            <div>
                <p>SEU ESPAÇO DE ACOLHIMENTO</p>
                <h2>Profissionais</h2>
            </div>
            <div class="perfil"><span>✧</span><span>Paciente</span></div>
        </header>

        <section class="secao">
            <p class="subtitulo">CUIDADO E ACOLHIMENTO</p>
            <h1>Encontre apoio profissional.</h1>
            <p>Conheça profissionais e encontre opções de atendimento adequadas às suas necessidades.</p>

            <article class="card">
                <h3>Buscar profissionais</h3>
                <form method="get" asp-controller="Home" asp-action="Profissionais">
                    <label for="especialidade">Especialidade</label>
                    <select id="especialidade" name="especialidade">
                        <option value="" selected="@(string.IsNullOrWhiteSpace(ViewBag.Especialidade as string))">Todas</option>
                        @foreach (string especialidade in (IEnumerable<string>)ViewBag.Especialidades)
                        {
                            <option value="@especialidade" selected="@(string.Equals(ViewBag.Especialidade as string, especialidade, StringComparison.OrdinalIgnoreCase))">@especialidade</option>
                        }
                    </select>

                    <button class="botao" type="submit">Buscar</button>
                </form>
            </article>

            <div class="cards">
                @if (!Model.Any())
                {
                    <article class="card"><h3>Nenhum profissional encontrado</h3><p>Cadastre médicos na tabela medicos para exibi-los aqui.</p></article>
                }
                @foreach (var medico in Model)
                {
                    <article class="card">
                        <h3>@medico.Nome</h3>
                        <p>@medico.Especialidade</p>
                        <p>CRM: @medico.CRM</p>
                    </article>
                }
            </div>
        </section>
    </main>
</div>
