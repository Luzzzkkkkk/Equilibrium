@{
    ViewData["Title"] = "Minhas consultas";
    ViewData["PaginaAtiva"] = "Consultas";
}

<div class="dashboard">
    <partial name="_Sidebar" />

    <main class="conteudo">
        <header class="topo">
            <div>
                <p>SEU ESPAÇO DE ACOLHIMENTO</p>
                <h2>Minhas consultas</h2>
            </div>

            <div class="perfil">
                <span>✧</span>
                <span>Paciente</span>
            </div>
        </header>

        <section class="secao">
            <p class="subtitulo">ACOMPANHE SEU CUIDADO</p>
            <h1>Seus horários, em um só lugar.</h1>
            <p>Acompanhe seus agendamentos e organize seus próximos atendimentos.</p>

            <div class="cards">
                <article class="card">
                    <h3>Nenhuma consulta cadastrada</h3>
                    <p>Quando houver um agendamento, você poderá acompanhar as informações da sua consulta por aqui.</p>
                    <a asp-controller="Home" asp-action="Profissionais">Encontrar profissionais →</a>
                </article>
            </div>
        </section>
    </main>
</div>
