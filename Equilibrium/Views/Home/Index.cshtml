@{
    ViewData["Title"] = "Início";
    ViewData["PaginaAtiva"] = "Index";
}
<div class="dashboard">
    <partial name="_Sidebar" />

    <main class="conteudo">
    
    <header class="topo">
            <div>
                <p>SEU ESPAÇO DE ACOLHIMENTO</p>
                <h2> Olá, Seja Bem-vindo(a)!</h2>
            </div>
        
            <div class="perfil">
                <span>✧</span>
                <span> Paciente </span>
            </div>
        
        </header>
    
        <section class="boas-vindas">
            <div>
                <p class="subtitulo"> UM MOMENTO PARA VOCÊ!</p>
            
                <h1> Um espaço para cuidar de você </h1>
            
                <p>
                    Sua saúde emocional importa.
                    Respeite seu tempo, acolha seus sentimentos
                    e cuide de si.
                </p>
      
            <a asp-controller="Home" asp-action="Profissionais" class="botao">
                Encontrar Profissionais
            </a>
        </div>

    </section>
  
    <section class="secao">
            <h2> Seu espaço pessoal </h2>
            <div class="cards"> 
                <article class="card">
                    <span>✧</span>
                    <h3> Meu Bem-estar </h3>
                    <p>
                        Registre seus sentimentos e acompanhe
                        seu momento emocional.
                    </p>
                    <a asp-controller="Home" asp-action="BemEstar">Acessar →</a>
                </article>

                <article class="card">
                    <span>✧</span>
                    <h3>Profissionais</h3>
                    <p>
                        Encontre profissionais e conheça
                        as opções de atendimento.
                    </p>
        
                    <a asp-controller="Home" asp-action="Profissionais">Encontrar →</a>
                </article>
      
                <article class="card">
                    <span>✧</span>
                    <h3> Consultas </h3>
                    <p>
                        Consulte seus agendamentos
                        e acompanhe seus horários.
                    </p>
                    <a asp-controller="Home" asp-action="Consultas">Visualizar →</a>
                </article>
      
            </div>
    
        </section>
    
        <footer>
            Equilibrium © 2026 — Um espaço para você.
        </footer>

    </main>

</div>
