@{
    ViewData["Title"] = "Administração";
}
<section class="auth-page">
    <div class="auth-card auth-card-wide">
        <a class="auth-brand" asp-controller="Admin" asp-action="Index">Equilibrium</a>
        <p class="auth-eyebrow">ÁREA ADMINISTRATIVA</p>
        <h1>Painel de administração</h1>
        <p class="auth-intro">Gerencie os profissionais cadastrados no site.</p>
        <div class="cards">
            <article class="card"><h3>@ViewBag.TotalPacientes pacientes</h3><p>Contas registradas.</p></article>
            <article class="card"><h3>@ViewBag.TotalMedicos profissionais</h3><p>Profissionais disponíveis no site.</p></article>
            <article class="card"><h3>@ViewBag.TotalConsultas consultas</h3><p>Agendamentos registrados.</p></article>
        </div>
        <div class="d-flex gap-2 mt-4">
            <a class="auth-button" asp-action="Profissionais">Gerenciar profissionais</a>
            <form asp-controller="Conta" asp-action="Logout" method="post"><button class="btn btn-outline-secondary" type="submit">Sair</button></form>
        </div>
    </div>
</section>
